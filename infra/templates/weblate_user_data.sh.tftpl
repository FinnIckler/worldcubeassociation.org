#!/bin/bash
# Bootstraps the Weblate instance. Runs on every ASG launch, including every
# Spot replacement. See weblate/DEPLOYMENT.md.
#
# TERRAFORM TEMPLATE, rendered by templatefile(). The only interpolations are
# volume_id and region; everything else must be plain shell.
#
# Terraform also parses dollar-brace and percent-brace sequences ANYWHERE in
# this file, comments included. Shell variables are therefore written bare as
# $VAR rather than with braces, which Terraform ignores. If you ever need brace
# syntax for a shell variable, double its leading dollar sign — otherwise the
# plan fails with "Invalid template interpolation value".
set -euxo pipefail

# Deliberately no `dnf update -y`: it adds minutes to every Spot replacement,
# and data.aws_ami.al2023 uses most_recent = true, so each replacement already
# launches a freshly patched AMI.
dnf install -y docker git gettext # gettext provides envsubst, used by render-env.sh

# Amazon Linux 2023 ships Docker but NOT the Compose v2 plugin — it is not in
# the AL2023 repos and `docker compose` fails without this.
mkdir -p /usr/local/lib/docker/cli-plugins
curl -sSL https://github.com/docker/compose/releases/download/v2.40.0/docker-compose-linux-x86_64 \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

TOKEN=$(curl -sX PUT http://169.254.169.254/latest/api/token \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" \
  http://169.254.169.254/latest/meta-data/instance-id)
PRIVATE_IP=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" \
  http://169.254.169.254/latest/meta-data/local-ipv4)

# --- Attach and mount the persistent data volume ----------------------------
# The instance being replaced may still be detaching it, so retry for up to five
# minutes rather than failing the boot.
ATTACHED=no
for _ in $(seq 1 30); do
  if aws ec2 attach-volume --region ${region} --volume-id ${volume_id} \
      --instance-id "$INSTANCE_ID" --device /dev/sdf; then
    ATTACHED=yes
    break
  fi
  sleep 10
done
test "$ATTACHED" = yes || { echo "could not attach ${volume_id}"; exit 1; }

# Nitro renames /dev/sdf unpredictably but exposes the volume ID as the device
# serial with the hyphen stripped, so resolve it that way rather than guessing
# /dev/nvme1n1 — which instance type we landed on is not known in advance.
SERIAL=$(echo "${volume_id}" | tr -d '-')
DEVICE=""
for _ in $(seq 1 30); do
  DEVICE=$(lsblk -o NAME,SERIAL -nr | awk -v s="$SERIAL" '$2==s {print "/dev/"$1}')
  test -n "$DEVICE" && break
  sleep 5
done
test -n "$DEVICE" || { echo "data volume never appeared as a block device"; exit 1; }

# Format ONLY if there is no filesystem yet. Every launch after the first must
# find the existing one. An unconditional mkfs here silently destroys every
# translation on the first Spot interruption, and the instance comes back
# looking perfectly healthy — this is the most dangerous line in the deployment.
blkid "$DEVICE" || mkfs -t xfs "$DEVICE"

# Mounting at /var/lib/docker puts images AND named volumes on the persistent
# disk: one thing to snapshot, and replacement instances skip re-pulling ~1 GB
# of images because they are already there.
mkdir -p /var/lib/docker
echo "UUID=$(blkid -s UUID -o value "$DEVICE") /var/lib/docker xfs defaults,nofail 0 2" >> /etc/fstab
mount /var/lib/docker
mountpoint -q /var/lib/docker || { echo "/var/lib/docker did not mount"; exit 1; }
# ----------------------------------------------------------------------------

# Only now, so the daemon never writes to the root volume by mistake.
systemctl enable --now docker

git clone --depth 1 --branch main \
  https://github.com/thewca/worldcubeassociation.org /opt/wca

install -m 0755 /opt/wca/weblate/spot-monitor.sh /usr/local/bin/weblate-spot-monitor
install -m 0644 /opt/wca/weblate/systemd/weblate.service /etc/systemd/system/
install -m 0644 /opt/wca/weblate/systemd/weblate-spot-monitor.service /etc/systemd/system/
systemctl daemon-reload

# Secrets come from SSM at boot; nothing sensitive is baked into the AMI or the
# repo. PRIVATE_IP is passed in because ALLOWED_HOSTS needs it and it changes
# with every replacement instance.
WEBLATE_PRIVATE_IP="$PRIVATE_IP" /opt/wca/weblate/render-env.sh

systemctl enable --now weblate-spot-monitor.service
systemctl enable --now weblate.service
