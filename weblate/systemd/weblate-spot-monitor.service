[Unit]
Description=Shut Weblate down cleanly on a Spot interruption notice
Documentation=https://github.com/thewca/worldcubeassociation.org/blob/main/weblate/DEPLOYMENT.md
After=weblate.service

[Service]
Type=simple
ExecStart=/usr/local/bin/weblate-spot-monitor

# on-failure, not always: the script exits 0 once it has handled an
# interruption, and restarting it then would just re-stop an already-stopped
# stack in a loop until the instance goes away.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
