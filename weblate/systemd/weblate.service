[Unit]
Description=Weblate translation server (docker compose)
Documentation=https://github.com/thewca/worldcubeassociation.org/blob/main/weblate/DEPLOYMENT.md
Requires=docker.service
After=docker.service network-online.target
# All state lives on the EBS volume mounted here. Starting without it would let
# Docker create empty volumes on the root disk and bring up a blank Weblate.
RequiresMountsFor=/var/lib/docker

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/wca/weblate

# First boot pulls ~1 GB of images and waits on the Postgres healthcheck before
# Weblate starts, which comfortably exceeds the 90s oneshot default.
TimeoutStartSec=600
TimeoutStopSec=120

ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.prod.yml down

[Install]
WantedBy=multi-user.target
